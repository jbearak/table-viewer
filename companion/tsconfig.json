  "include": ["src/**/*", "../src/sqlite-open-recovery.ts", "../src/sqlite-file-state-errors.ts", "../src/sqlite-file-state-schema.ts", "../src/sqlite-file-state-validation.ts", "../src/types.ts", "../src/immutable.ts"]
}
