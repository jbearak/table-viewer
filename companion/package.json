{
  "name": "table-viewer-companion",
  "displayName": "Table Viewer Migration and Recovery Companion",
  "description": "Profile-scoped namespace, migration capsule, and pending-edit recovery companion for Table Viewer.",
  "version": "0.7.0",
  "publisher": "jbearak",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbearak/table-viewer.git"
  },
  "engines": {
    "vscode": "^1.127.0"
  },
  "extensionKind": [
    "ui"
  ],
  "api": "none",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:tableViewerCompanion.hostCapabilities.v1",
    "onCommand:tableViewerCompanion.namespace.v1",
    "onCommand:tableViewerCompanion.activeCapsule.v1",
    "onCommand:tableViewerCompanion.submitCapsuleCandidate.v1",
    "onCommand:tableViewerCompanion.archiveDrift.v1",
    "onCommand:tableViewerCompanion.beginEnvironmentImport.v1",
    "onCommand:tableViewerCompanion.environmentImportStatus.v1",
    "onCommand:tableViewerCompanion.abandonEnvironmentImport.v1",
    "onCommand:tableViewerCompanion.confirmEnvironment.v1",
    "onCommand:tableViewerCompanion.confirmEnvironmentSourceRetirement.v1",
    "onCommand:tableViewerCompanion.preparePendingEditRecovery.v1",
    "onCommand:tableViewerCompanion.confirmPendingEditRecovery.v1",
    "onCommand:tableViewerCompanion.openRecovery",
    "onCommand:tableViewerCompanion.retireCapsule"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tableViewerCompanion.openRecovery",
        "title": "Table Viewer: Open Pending-Edit Recovery"
      },
      {
        "command": "tableViewerCompanion.retireCapsule",
        "title": "Table Viewer: Retire Frozen Migration Source"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm --prefix .. run bundle:companion",
    "package": "vsce package --no-dependencies"
  }
}
