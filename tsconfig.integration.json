{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["vscode", "node", "mocha"],
    // See tsconfig.json: @jbearak/dta-parser 1.0's "./node" subpath is exports-only.
    "paths": {
      "@jbearak/dta-parser/node": ["./node_modules/@jbearak/dta-parser/dist/node"]
    }
  },
  "include": ["src/test-integration/**/*"],
  "exclude": ["node_modules", "dist", "out"]
}
